# Apache config for the static export (Hostinger public_html).
Options -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Services renamed in the 2026 line-up
RewriteRule ^services/venture-studio/?$ /services/build-with-us/ [L,R=301]
RewriteRule ^services/fixed-price/?$ /services/custom-development/ [L,R=301]

# Form handlers: the site posts to /api/leads and /api/subscribe (PHP mails hello@vaug.in).
# Must come before the trailing-slash redirect, which would turn the POST into a GET.
RewriteRule ^api/(leads|subscribe)/?$ /api/$1.php [L]

# Add trailing slash to directory-style URLs (/about -> /about/)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]+$
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ /$1/ [L,R=301]

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
