# Port the API listens on (the web app proxies /api/* here)
PORT=4000
# Allowed browser origin for direct (non-proxied) calls
WEB_ORIGIN=http://localhost:3000
# Bearer token for GET /api/leads and GET /api/subscribers
ADMIN_API_TOKEN=change-me
# Optional: Slack/Discord/Zapier webhook notified on new leads and subscribers
LEAD_WEBHOOK_URL=
