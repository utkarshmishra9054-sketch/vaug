{
  "name": "vaug-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VAUG backend: leads, newsletter and content API.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup src/index.ts --format esm --target node20 --clean",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "hono": "^4.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5"
  }
}
